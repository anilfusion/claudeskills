        Id fakeId = TriggerTestUtility.getFakeId({{Object}}.SObjectType);
        {{Object}} record = new {{Object}}(
            Id = fakeId
            // ,set the fields this test scenario needs
        );

        Test.startTest();
        new TA_{{Object}}_{{Purpose}}().{{contextMethod}}(new List<{{Object}}>{ record } /*, triggerOld if applicable */);
        Test.stopTest();

        // assert against `record` directly (e.g. record.hasErrors(), record.getErrors(),
        // or a field value the method is expected to set)
    }
}
